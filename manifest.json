{
  "manifest_version": 3,
  "name": "Standalone Authenticator",
  "description": "Generate TOTP codes locally from a standalone popup.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "action": {
    "default_title": "Authenticator",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
